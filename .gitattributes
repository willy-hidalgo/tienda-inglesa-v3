# ---------------------------------------------------------------------------
# Normalización de fin de línea (tienda-inglesa-v3)
# ---------------------------------------------------------------------------
# Los archivos de texto se almacenan como LF en el índice y se hacen checkout
# como LF, independientemente de la configuración `core.autocrlf` del
# desarrollador (Windows/macOS/Linux). Esto elimina los warnings
#   "warning: LF will be replaced by CRLF ..."
# y evita diffs espurios por conversiones de línea.
# ---------------------------------------------------------------------------
# Regla global: auto-detectar archivos de texto y forzar LF.
* text=auto eol=lf

# Archivos binarios: nunca tocar sus bytes.
*.parquet  binary
*.xlsx     binary
*.xls      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.zip      binary
*.gz       binary
*.tar      binary
*.tgz      binary
*.bz2      binary
*.7z       binary
*.pyc      binary
*.pyo      binary
*.class    binary
*.jar      binary

# Fuentes / config: siempre LF.
*.py     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.md     text eol=lf
*.rst    text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.csv    text eol=lf
*.tsv    text eol=lf
*.gitignore text eol=lf
